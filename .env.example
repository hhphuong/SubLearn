# Copy this file to .env (same directory as docker-compose.yml) and fill in real
# values. `.env` is read automatically by `docker compose` / `podman compose` for
# ${VAR} substitution in docker-compose.yml - do not commit it.

# Required - the backend refuses to start with an empty secret.
# Must be at least 32 characters (HS256 key size).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Required for translation / word-meaning lookup to actually work (otherwise those
# features degrade gracefully with a "translation service unavailable" message).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_READ_TIMEOUT_MS=60000
# GEMINI_CONNECT_TIMEOUT_MS=10000

# Database (optional overrides)
# DB_NAME=sublearn
# DB_USERNAME=sublearn
# DB_PASSWORD=sublearn
# MYSQL_ROOT_PASSWORD=sublearn
# MYSQL_PORT=3306

# RabbitMQ (optional overrides)
# RABBITMQ_USERNAME=sublearn
# RABBITMQ_PASSWORD=sublearn
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

# Ports / URLs (optional overrides).
# If you change FRONTEND_PORT, update FRONTEND_ORIGIN too (CORS).
# The frontend container proxies /api/* to the backend (nginx), so the browser never
# talks to BACKEND_PORT directly. BACKEND_PORT is only for Postman / debugging.
# Leave VITE_API_BASE_URL empty (same-origin) unless you really need a direct URL.
# FRONTEND_PORT=5173
# FRONTEND_ORIGIN=http://localhost:5173
# BACKEND_PORT=8080
# VITE_API_BASE_URL=

# Extra JVM options for the backend, e.g. -Xmx512m
# JAVA_OPTS=

# yt-dlp authentication is mounted (optional) from ./secrets/youtube-cookies.txt.
# Never commit or share that file.
